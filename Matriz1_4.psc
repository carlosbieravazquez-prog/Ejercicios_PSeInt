

Algoritmo Matriz1_4
	
	Dimension da1[3] 
	Dimension da2[3]
	Dimension suma[3]
	
	para i <- 1 Hasta 3
		Escribir "Dime el dato numero ", i
		Leer da1[i]
	FinPara
	para i <- 1 Hasta 3
		Escribir "Dime el dato numero ", i
		Leer da2[i]
